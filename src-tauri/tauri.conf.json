{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonoraMix",
  "version": "1.0.0",
  "identifier": "dev.sonoramix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SonoraMix — Audio Session Console",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#0b0d0f",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "category": "Utility",
    "shortDescription": "Per-app volume, mute, metering and output routing for Windows.",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
